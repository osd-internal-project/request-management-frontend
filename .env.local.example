# Copy to .env.local
# Backend user-service base URL (server-side only, used by the /api/auth/* routes)
USER_SERVICE_URL=http://localhost:3001
CORE_SERVICE_URL=http://localhost:3002
RUN_NUMBER_SERVICE_URL=http://localhost:3004

# AUTH-02 session idle timeout (seconds). Caps the auth cookies and is the
# window SessionKeeper measures inactivity against.
SESSION_IDLE_TIMEOUT_SECONDS=900
# How often the browser renews the tokens while the user is active (seconds).
SESSION_REFRESH_INTERVAL_SECONDS=300
# CD-66 — the public request form (/f/...). Server-side only: the pages call
# external-service with an API key holding `integration.request.intake` (issue
# it at ผู้ดูแล → กุญแจ API, bound to one company). Unset = the form says the
# channel is not ready.
EXTERNAL_SERVICE_URL=http://localhost:3003
CUSTOMER_INTAKE_API_KEY=

# LibreChat (aiyara) widget in the ผู้ช่วย AI panel. Origin only, no path.
# LibreChat's own host, never this app's domain (the script would hit our
# login redirect). An https page needs an https widget URL (mixed content).
# Unset = the panel says the assistant is not configured.
LIBRECHAT_WIDGET_URL=http://192.168.31.52
LIBRECHAT_WIDGET_PUBLIC_ID=feKqnrmmNS0jfdjCnXND5Kql
