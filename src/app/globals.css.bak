@import "tailwindcss";

.login-marketing-content {
  top: 30.4%;
}

@media (min-width: 1024px) and (max-height: 800px) {
  .login-marketing-content {
    top: 24%;
  }
}

:root {
  --blue: #3b82f6;
  --blue-hover: #60a5fa;
  --blue-dark: #2563eb;

  --blue-soft: #eef4ff;
  --blue-softer: #f5f8fe;

  --bg: #f6f8fc;
  --white: #ffffff;

  --text: #24344d;
  --text-secondary: #718096;
  --text-muted: #9aa9bc;

  --border: #e4eaf2;
  --border-light: #edf1f6;

  --radius: 10px;
  --radius-lg: 14px;
}


/* =========================
   App
========================= */

.app {
  min-height: 100vh;
  background: var(--bg);
  color: var(--text);
}


/* =========================
   Header
========================= */

.app-header {
  height: 72px;
  padding: 0 24px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  background: #fff;
  border-bottom: 1px solid var(--border);

  position: sticky;
  top: 0;
  z-index: 100;
}

.app-header-left {
  display: flex;
  align-items: center;
  gap: 32px;
}

.app-logo {
  font-size: 20px;
  font-weight: 700;
  color: #172A44;
  letter-spacing: -0.3px;
}

.company-select {
  display: flex;
  align-items: center;
  gap: 12px;
}

.company-label {
  color: var(--text-secondary);
  font-size: 14px;
}


/* =========================
   Sidebar
========================= */

.app-sidebar {
  width: 248px;

  background: #fff;
  border-right: 1px solid var(--border);

  padding: 18px 14px;

  display: flex;
  flex-direction: column;

  min-height: calc(100vh - 72px);
}

.sidebar-menu {
  flex: 1;
}

.sidebar-item {
  height: 46px;

  display: flex;
  align-items: center;

  padding: 0 14px;
  margin-bottom: 4px;

  border-radius: 10px;

  color: #52627a;

  font-size: 14px;
  font-weight: 500;

  cursor: pointer;

  transition:
    background 0.15s ease,
    color 0.15s ease;
}

.sidebar-item:hover {
  background: var(--blue-softer);
  color: var(--blue-dark);
}

.sidebar-item.active {
  background: var(--blue-soft);
  color: var(--blue-dark);
  font-weight: 600;
}

.sidebar-item-icon {
  width: 22px;
  margin-right: 12px;
}


/* =========================
   Main
========================= */

.app-main {
  flex: 1;
  min-width: 0;

  padding: 34px 42px 24px;

  background: var(--bg);
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 20px;
}

.page-title {
  display: flex;
  align-items: baseline;
  gap: 10px;

  font-size: 22px;
  font-weight: 700;

  color: var(--text);
}

.page-subtitle {
  color: var(--text-muted);
  font-size: 14px;
  font-weight: 400;
}


/* =========================
   Content Grid
========================= */

.content-grid {
  display: grid;

  grid-template-columns:
    minmax(360px, 0.9fr)
    minmax(500px, 1.25fr);

  gap: 18px;

  align-items: start;
}


/* =========================
   Cards
========================= */

.dashboard-card {
  background: #fff;

  border: 1px solid var(--border);
  border-radius: var(--radius-lg);

  box-shadow:
    0 2px 8px rgba(30, 64, 100, 0.035);

  overflow: hidden;
}

.dashboard-card-header {
  min-height: 56px;

  padding: 0 22px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid var(--border-light);
}

.dashboard-card-title {
  font-size: 16px;
  font-weight: 650;
  color: var(--text);
}

.dashboard-card-body {
  padding: 20px 22px;
}


/* =========================
   Team Tree
========================= */

.team-tree {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.team-tree-row {
  min-height: 40px;

  display: flex;
  align-items: center;

  padding: 0 8px;

  border-radius: 8px;

  color: #3E4E64;

  transition: background 0.15s ease;
}

.team-tree-row:hover {
  background: #F7F9FC;
}

.team-tree-row.selected {
  background: #EEF4FF;
  color: #2563EB;
}

.team-tree-name {
  font-weight: 500;
}

.team-tree-count {
  margin-left: auto;

  color: #9AA9BC;
  font-size: 13px;
}

.team-tree-leader {
  color: #9AA9BC;
  font-size: 13px;
  margin-left: 12px;
}


/* =========================
   Member List
========================= */

.member-row {
  display: flex;
  align-items: center;

  padding: 14px 0;

  border-bottom: 1px solid var(--border-light);
}

.member-row:last-child {
  border-bottom: 0;
}

.member-avatar {
  flex: 0 0 auto;
  margin-right: 12px;
}

.member-info {
  min-width: 0;
  flex: 1;
}

.member-name {
  font-weight: 600;
  color: var(--text);
}

.member-role {
  margin-top: 3px;

  color: var(--text-muted);
  font-size: 13px;
}

.member-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}


/* =========================
   Soft badges
========================= */

.scope-badge {
  display: inline-flex;
  align-items: center;

  height: 24px;

  padding: 0 8px;

  border-radius: 6px;

  background: #EEF4FF;
  color: #3568C9;

  font-size: 12px;
  font-weight: 500;
}

.role-badge {
  display: inline-flex;

  height: 24px;

  align-items: center;

  padding: 0 8px;

  border-radius: 6px;

  background: #F3F5F8;
  color: #52627A;

  font-size: 12px;
}


/* =========================
   Info box
========================= */

.info-box {
  display: flex;
  gap: 10px;

  padding: 12px 14px;

  background: #F7FAFF;

  border: 1px solid #DCE8FB;

  border-radius: 9px;

  color: #718096;

  font-size: 13px;
  line-height: 1.6;
}


/* =========================
   Empty State
========================= */

.empty-state {
  min-height: 190px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;

  color: var(--text-muted);
}

.empty-state-icon {
  margin-bottom: 12px;

  font-size: 42px;

  opacity: 0.45;
}

.empty-state-text {
  font-size: 14px;
}


/* =========================
   Footer
========================= */

.app-footer {
  padding: 30px 0 10px;

  text-align: center;

  color: #718096;
  font-size: 13px;
}


/* =========================
   Responsive
========================= */

@media (max-width: 1100px) {
  .app-main {
    padding: 28px 24px;
  }

  .content-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .app-sidebar {
    width: 72px;
    padding: 16px 8px;
  }

  .sidebar-item {
    justify-content: center;
    padding: 0;
  }

  .sidebar-item-icon {
    margin-right: 0;
  }

  .sidebar-item-label {
    display: none;
  }

  .app-main {
    padding: 20px 16px;
  }

  .page-header {
    align-items: flex-start;
  }
}