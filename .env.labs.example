# Template for /opt/request-management/labs/frontend.env on the labs VM.
#
# COMMITTED FILE — PLACEHOLDERS ONLY. Copy it to the VM, fill it in there, and
# `chmod 600` it.
#
#   scp .env.labs.example <vm>:/tmp/frontend.env
#   sudo install -m 600 /tmp/frontend.env /opt/request-management/labs/frontend.env

NODE_ENV=production

# The Dockerfile sets these too; repeated here so one file describes the whole
# runtime rather than half of it.
PORT=3000
HOSTNAME=0.0.0.0

# Where browsers reach this app. It is what the app builds absolute URLs from,
# and it has to match the redirect URIs registered on the Keycloak client.
APP_ORIGIN=http://<LABS_HOST>:3000

# ORIGINS ONLY — src/lib/backend.ts appends BACKEND_PREFIX ("/api/v1") to every
# outbound call, so a prefix here produces /api/v1/api/v1. The backend stack has
# a variable of the same name that DOES include the prefix; do not copy between
# the two files.
#
# The hostnames are container names on the shared `rm-labs` network.
USER_SERVICE_URL=http://user-service:3001
CORE_SERVICE_URL=http://core-service:3002

SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_REFRESH_INTERVAL_SECONDS=300
