# Template for /etc/request-management/.frontend.env on the labs VM.
#
# COMMITTED FILE — PLACEHOLDERS ONLY. Copy it to the VM and fill it in there.
#
# Mode 640 with the runner's group: compose reads this as the runner's user, and
# a root-owned 600 file fails the deploy with `env file … not found`.
#
#   scp .env.labs.example <vm>:/tmp/frontend.env
#   sudo install -m 640 -g github-runner /tmp/frontend.env /etc/request-management/.frontend.env

NODE_ENV=production

# The port INSIDE the container. The compose file publishes it on the host as
# 3500; this value must stay 3000 or the published port maps to nothing.
PORT=3000
HOSTNAME=0.0.0.0

# Where browsers reach this app, so this one carries the HOST port (3500). It is
# what the app builds absolute URLs from, and it has to match the redirect URIs
# registered on the Keycloak client.
APP_ORIGIN=http://<LABS_HOST>:3500

# ORIGINS ONLY — src/lib/backend.ts appends BACKEND_PREFIX ("/api/v1") to every
# outbound call, so a prefix here produces /api/v1/api/v1. The backend stack has
# a variable of the same name that DOES include the prefix; do not copy between
# the two files.
#
# Container names on the shared `rm-net` network, with the ports INSIDE those
# containers — these calls never leave the network, so the published 3501/3502
# have nothing to do with them.
USER_SERVICE_URL=http://rm-user:3001
CORE_SERVICE_URL=http://rm-core:3002
RUN_NUMBER_SERVICE_URL=http://rm-runnumber:3004

SESSION_IDLE_TIMEOUT_SECONDS=900
SESSION_REFRESH_INTERVAL_SECONDS=300
